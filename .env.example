# ── AWS ────────────────────────────────────────────────────
# Credenciais temporárias do AWS Lab (STS) — substitua pelos valores reais.
# O AWS_SESSION_TOKEN é OBRIGATÓRIO para acessar DynamoDB real fora da Lambda.
# ⚠️ NUNCA commitar este arquivo com valores reais (use .env.example como template).
AWS_ACCESS_KEY_ID=SEU_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=SEU_SECRET_ACCESS_KEY
AWS_SESSION_TOKEN=SEU_SESSION_TOKEN_DO_LAB
AWS_REGION=us-east-1

# ── DynamoDB ───────────────────────────────────────────────
DYNAMODB_TABLE_NAME=fcg-notification-users

# URLs das filas SQS (obtidas após criar as filas no console AWS ou via Terraform)
# Formato: https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>
SQS_URL_USER_CREATED=https://sqs.us-east-1.amazonaws.com/123456789012/fcg-user-created
SQS_URL_PAYMENT_PROCESSED=https://sqs.us-east-1.amazonaws.com/123456789012/fcg-payment-processed